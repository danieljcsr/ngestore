// NgeStore data model.
//
// Runs on Postgres (Neon, provisioned via Vercel Storage) in production.
// Local development can still point DATABASE_URL at a local SQLite file if
// you switch `provider` back temporarily — but keep that local-only, don't
// commit it, since production is Postgres now.
//
// No column type used below is Postgres- or SQLite-specific. Keep it that
// way in application code too: avoid connector-only query features (e.g.
// Prisma's `mode: "insensitive"` string filter only works on Postgres/
// MongoDB) — filter/sort in JS instead when in doubt, so dev and prod stay
// behaviorally identical. app/games/page.tsx does this for search.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  category        String
  badgeLabel      String
  badgeFrom       String
  badgeTo         String
  // Optional uploaded cover image (JPG/PNG/WEBP via Vercel Blob). When null,
  // the storefront falls back to the generated badgeLabel/badgeFrom/badgeTo icon.
  imageUrl        String?
  requiresZoneId  Boolean  @default(false)
  playerIdLabel   String   @default("User ID")
  zoneIdLabel     String   @default("Zone ID")
  instructions    String?
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  denominations Denomination[]
  orders        Order[]

  @@index([isActive, sortOrder])
}

model Denomination {
  id        String   @id @default(cuid())
  gameId    String
  name      String
  price     Int
  note      String?
  isActive  Boolean  @default(true)
  isPopular Boolean  @default(false)
  sortOrder Int      @default(0)
  // Maps this nominal to the supplier/provider's own product code (SKU), e.g.
  // Digiflazz's buyer_sku_code. Null = not connected to a supplier yet, so
  // orders for it are fulfilled manually like before.
  providerSku String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game   Game    @relation(fields: [gameId], references: [id], onDelete: Restrict)
  orders Order[]

  @@index([gameId, isActive, sortOrder])
}

// Order status values (kept as a plain string for SQLite/Postgres portability):
//   PENDING_PAYMENT -> PAID -> PROCESSING -> COMPLETED
//                   -> FAILED / EXPIRED / CANCELLED
model Order {
  id     String @id @default(cuid())
  orderCode String @unique

  gameId          String
  gameName        String
  denominationId  String
  denominationName String
  amount          Int

  playerId String
  zoneId   String?

  contactName     String
  contactWhatsapp String
  contactEmail    String?

  status String @default("PENDING_PAYMENT")

  paymentMethod            String?
  midtransToken            String?
  midtransRedirectUrl      String?
  midtransTransactionId    String?
  midtransTransactionStatus String?

  adminNote String?

  // Supplier/provider fulfillment tracking (see ProviderSetting). All null
  // until an attempt is made to send this order to the configured supplier.
  providerRefId         String?   @unique
  providerTrxId         String?
  providerStatus        String?
  providerMessage       String?
  fulfillmentSentAt     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  fulfilledAt DateTime?

  game         Game         @relation(fields: [gameId], references: [id], onDelete: Restrict)
  denomination Denomination @relation(fields: [denominationId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([orderCode])
}

// Singleton row (always the first/only record) holding the connection details
// for an automatic top-up supplier (e.g. Digiflazz or similar H2H provider).
// Kept in the database — not env vars — so the store owner can plug in their
// own provider from the admin dashboard without a redeploy. Credentials are
// stored as plain text here deliberately (same trust boundary as env vars:
// only reachable by an authenticated admin, via the same protected API
// surface as the rest of /api/admin/*).
model ProviderSetting {
  id           String  @id @default(cuid())
  isEnabled    Boolean @default(false)
  providerName String  @default("Provider Top Up")
  apiBaseUrl   String?
  apiUsername  String?
  apiKey       String?
  // Two request/response shapes are supported out of the box (see
  // lib/provider.ts): "digiflazz" (username + buyer_sku_code + customer_no +
  // ref_id[+ md5 sign], text status field) and "bearer_json" (Authorization:
  // Bearer apiKey, body {code, msisdn, request_id}, numeric "rc" response
  // code — this is the shape documented by e.g. Media Cakrawangsa).
  requestFormat String @default("digiflazz")
  // Most Indonesian H2H top-up providers (Digiflazz and many compatible
  // clones) sign requests with md5(username + apiKey + ref_id). Turn this
  // off for a provider that authenticates a different way (e.g. a bearer
  // token sent as the apiKey value). Only applies to requestFormat "digiflazz".
  useMd5Signature Boolean @default(true)
  // Some providers require a separate transaction PIN in addition to the API
  // key (often used alongside IP whitelisting). Sent as a "pin" field on every
  // dispatch request when set; omitted entirely when null.
  transactionPin String?
  // Vercel serverless functions have no fixed outbound IP by default. If your
  // provider requires IP whitelisting, put an HTTP proxy URL from a static-IP
  // service here (e.g. Fixie's FIXIE_URL, format http://user:pass@host:port)
  // and every provider request routes through it instead of connecting
  // directly. Leave empty to connect directly (default).
  outboundProxyUrl String?
  // Shared secret the provider's callback URL must include (as ?token=... or
  // an X-Callback-Token header) before an inbound status update is trusted.
  callbackToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton, same pattern as ProviderSetting. Lets the store owner close
// checkout during a fixed daily window (e.g. 23:00-01:00 WIB) without a
// redeploy. startTime/endTime are "HH:mm" in Asia/Jakarta (WIB) — see
// lib/maintenance.ts for the window check, which handles a window that
// wraps past midnight (start > end).
model MaintenanceSetting {
  id        String  @id @default(cuid())
  isEnabled Boolean @default(false)
  startTime String  @default("23:00")
  endTime   String  @default("01:00")
  message   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton, same pattern as ProviderSetting/MaintenanceSetting. Public
// contact details shown in the storefront footer — admin-editable so the
// store owner can update their CS number/email without a redeploy.
model SiteContactSetting {
  id         String  @id @default(cuid())
  csWhatsapp String?
  csEmail    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               String    @default("admin")
  // Gates access to Manajemen Pengguna (view + manage other admin accounts).
  // Deliberately separate from the free-text `role` label above — `role` is
  // just a display string an owner can edit freely, so overloading it as the
  // permission flag would mean retyping it could silently strip access.
  // There's no UI to grant this to anyone else; it's only ever set via
  // prisma/seed.ts for the ADMIN_EMAIL account.
  isOwner            Boolean   @default(false)
  failedLoginAttempts Int      @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
}
