// NgeStore data model.
//
// Local development uses SQLite (zero setup). Production deploys switch
// `provider` below to "postgresql" and point DATABASE_URL at a hosted
// Postgres instance — see DEPLOY.md step 1 for the exact change and why
// it's a one-time, permanent switch rather than something to toggle back.
//
// No column type used below is Postgres- or SQLite-specific. Keep it that
// way in application code too: avoid connector-only query features (e.g.
// Prisma's `mode: "insensitive"` string filter only works on Postgres/
// MongoDB) — filter/sort in JS instead when in doubt, so dev and prod stay
// behaviorally identical. app/games/page.tsx does this for search.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Game {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  category        String
  badgeLabel      String
  badgeFrom       String
  badgeTo         String
  requiresZoneId  Boolean  @default(false)
  playerIdLabel   String   @default("User ID")
  zoneIdLabel     String   @default("Zone ID")
  instructions    String?
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  denominations Denomination[]
  orders        Order[]

  @@index([isActive, sortOrder])
}

model Denomination {
  id        String   @id @default(cuid())
  gameId    String
  name      String
  price     Int
  note      String?
  isActive  Boolean  @default(true)
  isPopular Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game   Game    @relation(fields: [gameId], references: [id], onDelete: Restrict)
  orders Order[]

  @@index([gameId, isActive, sortOrder])
}

// Order status values (kept as a plain string for SQLite/Postgres portability):
//   PENDING_PAYMENT -> PAID -> PROCESSING -> COMPLETED
//                   -> FAILED / EXPIRED / CANCELLED
model Order {
  id     String @id @default(cuid())
  orderCode String @unique

  gameId          String
  gameName        String
  denominationId  String
  denominationName String
  amount          Int

  playerId String
  zoneId   String?

  contactName     String
  contactWhatsapp String
  contactEmail    String?

  status String @default("PENDING_PAYMENT")

  paymentMethod            String?
  midtransToken            String?
  midtransRedirectUrl      String?
  midtransTransactionId    String?
  midtransTransactionStatus String?

  adminNote String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  fulfilledAt DateTime?

  game         Game         @relation(fields: [gameId], references: [id], onDelete: Restrict)
  denomination Denomination @relation(fields: [denominationId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([orderCode])
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               String    @default("admin")
  failedLoginAttempts Int      @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
}
