# Database. Local dev uses SQLite out of the box.
# For production, switch prisma/schema.prisma datasource provider to
# "postgresql" and set this to your Neon/Vercel Postgres connection string.
DATABASE_URL="file:./dev.db"

# Midtrans (Settings > Access Keys in the Midtrans Dashboard).
# Leave IS_PRODUCTION=false until you have verified, live (non-sandbox) keys.
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"

# Random secret used to sign admin session cookies. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Required before running `npx prisma db seed` — there is no built-in default, on
# purpose, so a real production database can never end up with guessable admin
# credentials. Password must be at least 10 characters and not the placeholder below.
ADMIN_EMAIL="admin@ngestore.id"
ADMIN_PASSWORD="replace-with-a-real-password"

# Public base URL of the site (used for Midtrans finish/callback redirects).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
